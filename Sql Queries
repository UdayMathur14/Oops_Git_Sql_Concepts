--For Nth max salary

-WITH RankedSalaries AS (
    SELECT salary, DENSE_RANK() OVER (ORDER BY salary DESC) as rnk
    FROM employees
    WHERE salary IS NOT NULL 
)
SELECT DISTINCT salary 
FROM RankedSalaries 
WHERE rnk = 2;


-SELECT DISTINCT e1.salary 
FROM employees e1
WHERE n-1 = (
    SELECT COUNT(DISTINCT e2.salary) 
    FROM employees e2 
    WHERE e2.salary > e1.salary
);

--Top N Records Per Group

-WITH RankedEmployees AS (
    SELECT 
        emp_name,
        department,
        salary,
        ROW_NUMBER() OVER (PARTITION BY department ORDER BY salary DESC) as row_num
    FROM employees
    WHERE salary IS NOT NULL
)
SELECT emp_name, department, salary
FROM RankedEmployees
WHERE row_num <= 2;

--delete duplicate records 

- DELETE FROM employees
WHERE emp_id NOT IN (
    SELECT MIN(emp_id)
    FROM employees
    GROUP BY emp_name, department, salary
);


-WITH CTE_Duplicates AS (
    SELECT 
        emp_id,
        emp_name,
        department,
        ROW_NUMBER() OVER (
            PARTITION BY emp_name, department, salary -- In columns ke base par check karo ki duplicate kaun hai
            ORDER BY emp_id ASC -- Pehla wala record rank 1 payega, baaki duplicates 2, 3...
        ) as row_num
    FROM employees
)
SELECT * FROM CTE_Duplicates WHERE row_num > 1; -- Ye query sirf duplicate rows dikhayegi








